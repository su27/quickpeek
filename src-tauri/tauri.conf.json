{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickPeek",
  "version": "0.10.10",
  "identifier": "com.su27.quickpeek",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuickPeek",
        "width": 860,
        "height": 600,
        "minWidth": 320,
        "minHeight": 220,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --lang=en-US",
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#202020"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; connect-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; frame-src 'self' blob: asset: http://asset.localhost; font-src 'self' blob: data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB ebook",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": ["doc"],
        "name": "Legacy Word document",
        "description": "Legacy Word binary document",
        "role": "Viewer",
        "mimeType": "application/msword"
      },
      {
        "ext": ["ppt", "pps", "pot"],
        "name": "Legacy PowerPoint presentation",
        "role": "Viewer"
      },
      {
        "ext": ["rtf"],
        "name": "RTF document",
        "role": "Viewer"
      },
      {
        "ext": ["ttf", "otf", "woff", "woff2"],
        "name": "Font preview",
        "role": "Viewer"
      },
      {
        "ext": ["docm", "docx", "dotm", "dotx"],
        "name": "Word document",
        "description": "Open XML Word document",
        "role": "Viewer",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": ["csv", "ods", "tsv", "xls", "xlsb", "xlsm", "xlsx", "xltm", "xltx"],
        "name": "Spreadsheet",
        "description": "Spreadsheet file",
        "role": "Viewer",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": ["potm", "potx", "ppsm", "ppsx", "pptm", "pptx"],
        "name": "PowerPoint presentation",
        "description": "Open XML PowerPoint presentation",
        "role": "Viewer",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": ["apng", "avif", "bmp", "gif", "heic", "heif", "ico", "jfif", "jpeg", "jpg", "png", "svg", "tif", "tiff", "webp"],
        "name": "Image",
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": ["aac", "flac", "m4a", "mp3", "ogg", "opus", "wav"],
        "name": "Audio",
        "description": "Audio file",
        "role": "Viewer"
      },
      {
        "ext": ["m4v", "mov", "mp4", "ogv", "webm"],
        "name": "Video",
        "description": "Video file",
        "role": "Viewer"
      },
      {
        "ext": ["zip", "jar", "war", "apk", "vsix", "nupkg", "tar", "tgz", "tbz2", "txz", "7z", "rar"],
        "name": "Archive",
        "description": "Archive contents",
        "role": "Viewer",
        "mimeType": "application/zip"
      },
      {
        "ext": ["bash", "bat", "c", "cc", "cfg", "cjs", "clj", "cljs", "cmd", "conf", "cpp", "cs", "css", "dart", "env", "erl", "ex", "exs", "go", "h", "hpp", "hrl", "htm", "html", "ini", "java", "js", "json", "jsonc", "jsx", "kt", "kts", "less", "log", "lua", "md", "markdown", "mjs", "php", "pl", "ps1", "py", "pyw", "r", "rb", "rs", "scala", "scss", "sh", "sql", "srt", "svelte", "swift", "toml", "ts", "tsx", "txt", "vue", "xml", "yaml", "yml", "zsh"],
        "name": "Text and source code",
        "description": "Text and source code",
        "role": "Viewer"
      }
    ],
    "shortDescription": "A lightweight, offline file viewer",
    "longDescription": "QuickPeek is a lightweight, read-only viewer for documents, spreadsheets, presentations, PDF, images, media, archives, text, and code. Files stay on your computer.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
